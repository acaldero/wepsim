{
    "compilerOptions": {
        "target": "es2017",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "es2017",
            "dom"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "noEmit": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "sim_hw/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "ws_dist"
    ]
}