{
    "compilerOptions": {
        "target": "es2017",
        "module": "es2022",
        "lib": [
            "es2017",
            "dom"
        ],
        "outDir": "./src_ts",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": false,
        "sourceMap": false,
        "allowJs": true,
        "checkJs": false,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "noUnusedLocals": false,
	"noUnusedParameters": false,
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.js",
        "./src/**/*.d.ts"
    ],
    "exclude": []
}
